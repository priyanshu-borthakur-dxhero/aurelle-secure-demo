{
  "name": "node-app",
  "version": "1.0.0",
  "private": true,
  "description": "Category C demo app - Node.js ecommerce API persisting to PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node --require dd-trace/init server.js",
    "start:plain": "node server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dd-trace": "^6.13.0",
    "express": "^4.19.2",
    "lodash": "4.17.15",
    "pg": "^8.13.1",
    "pino": "^9.14.0"
  }
}
